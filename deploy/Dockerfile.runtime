ARG BUN_IMAGE=oven/bun:1.4.4-alpine
FROM ${BUN_IMAGE}
WORKDIR /app
COPY dist ./dist
COPY server.ts ./server.ts
COPY LICENSE ./LICENSE
COPY artifact-manifest.json ./artifact-manifest.json
RUN mkdir -p /data && chown bun:bun /data
USER bun
ENV LEDGER_DATABASE=/data/ledger.sqlite LEDGER_HOST=0.0.0.0 PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD bun -e 'const r=await fetch("http://127.0.0.1:3000/healthz");process.exit(r.ok?0:1)'
CMD ["bun", "run", "server.ts"]
