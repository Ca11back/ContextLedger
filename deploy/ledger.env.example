# Replace both placeholders with fresh, distinct credentials before use. Keep the real file mode 0600.
LEDGER_ADMIN_USER=admin
LEDGER_ADMIN_PASSWORD=<replace-with-new-admin-password-minimum-16-characters>
LEDGER_INGEST_TOKEN=<replace-with-new-ingest-token-minimum-24-characters>
LEDGER_SOURCE=new-api
LEDGER_DATABASE=/data/ledger.sqlite
# Positive integer decimal MB (1 MB = 1,000,000 bytes); 10000 MB = 10 GB.
# Image layers, backups and logs have separate budgets.
LEDGER_MAX_STORAGE_MB=10000
LEDGER_HOST=0.0.0.0
PORT=3000
# Optional maximum age is disabled unless explicitly configured.
# LEDGER_MAX_AGE_DAYS=30
