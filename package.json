{
  "name": "contextledger",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "start": "bun run server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "integrity": "bun run scripts/integrity.ts",
    "benchmark": "bun run experiments/benchmark.ts",
    "package:runtime": "bun run scripts/package-runtime.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "audit:client": "bun run scripts/client-boundary.ts",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run audit:client"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@rsbuild/core": "2.3.2",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
